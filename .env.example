# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Neon PostgreSQL (replace with your actual Neon connection string) ───
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/bidlow?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=bidlow_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
# Frontend customer app
FRONTEND_URL=http://localhost:5173
# Admin panel app
ADMIN_URL=http://localhost:5174

# ─── Bcrypt ───────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
